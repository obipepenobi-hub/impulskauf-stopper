<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <!-- Only the database leaves the device, via cloud backup AND device-to-device transfer.
         Without an explicit <device-transfer> section Android falls back to "everything",
         which would copy the product screenshots (files/wish_images) to a new phone. -->
    <cloud-backup>
        <include domain="database" path="." />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="." />
    </device-transfer>
</data-extraction-rules>
